{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/trops/dash-check/recipe/schema.json",
  "title": "dash-check recipe",
  "description": "A check made of steps: helpers (use) and value expectations (expect). It holds no code, so it is safe to store on a bot, share and edit in a UI.",
  "type": "object",
  "required": ["name", "steps"],
  "additionalProperties": false,
  "properties": {
    "$schema": { "type": "string" },
    "name": { "type": "string", "minLength": 1, "maxLength": 200, "description": "What the check proves" },
    "description": { "type": "string", "maxLength": 2000 },
    "version": { "type": "integer", "minimum": 1, "description": "The recipe format's version (1)" },
    "steps": {
      "type": "array",
      "minItems": 1,
      "maxItems": 100,
      "items": { "oneOf": [{ "$ref": "#/definitions/useStep" }, { "$ref": "#/definitions/expectStep" }] }
    }
  },
  "definitions": {
    "when": {
      "type": ["string", "boolean"],
      "description": "Run the step only when this is truthy: a value path (handoff.prUrl) or a placeholder ({mergeWhenGreen}); a leading ! turns it around"
    },
    "message": { "type": "string", "maxLength": 2000, "description": "What a failure says instead (the fix)" },
    "label": { "type": "string", "maxLength": 200, "description": "The row's own name (default: the helper's label)" },
    "useStep": {
      "type": "object",
      "required": ["use"],
      "additionalProperties": false,
      "properties": {
        "use": { "type": "string", "pattern": "^[a-z][A-Za-z0-9]*(\\.[a-z][A-Za-z0-9]*)+$", "description": "A helper's id, e.g. git.committedSince" },
        "with": { "type": "object", "description": "The helper's params; strings can hold {placeholders} from settings, item and row" },
        "when": { "$ref": "#/definitions/when" },
        "message": { "$ref": "#/definitions/message" },
        "label": { "$ref": "#/definitions/label" }
      }
    },
    "expectStep": {
      "type": "object",
      "required": ["expect", "matcher"],
      "additionalProperties": false,
      "properties": {
        "expect": { "type": "string", "pattern": "^[A-Za-z_$][\\w$-]*(\\.[\\w$-]+)*$", "description": "A value by path: handoff.files, item.id, env.DASH_BRANCH, repo.baseBranch" },
        "matcher": { "type": "string", "pattern": "^to[A-Z][A-Za-z0-9]*$", "description": "A matcher's id, e.g. toHaveLengthAtLeast" },
        "args": { "type": "array", "description": "The matcher's params, in order; strings can hold {placeholders}" },
        "not": { "type": "boolean", "description": "Expect the opposite" },
        "when": { "$ref": "#/definitions/when" },
        "message": { "$ref": "#/definitions/message" },
        "label": { "$ref": "#/definitions/label" }
      }
    }
  }
}
